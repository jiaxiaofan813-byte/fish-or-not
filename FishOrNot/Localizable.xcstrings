    "By default, compare the 12 closest eligible waters using one nearby access point per water. Comparing all 50 can take longer. Driving limits still apply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, compare the 12 closest eligible waters using one nearby access point per water. Comparing all 50 can take longer. Driving limits still apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认比较距离最近的 12 个符合条件的水域，每个水域使用一个附近入口。比较全部 50 个会耗时更长，仍会按车程上限筛选。"
          }
        }
      }
    },
